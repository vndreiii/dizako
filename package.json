{
  "name": "dizako",
  "private": true,
  "version": "2.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "golden:capture": "GOLDEN_CAPTURE=1 vitest run",
    "build:wasm": "wasm-pack build dither-wasm --release --target web --out-dir pkg",
    "lint": "eslint src test tools --ext .ts,.tsx,.js,.mjs"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "^5.2.0",
    "@fontsource/roboto-mono": "^5.2.0",
    "@material/material-color-utilities": "^0.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "dither-wasm": "file:./dither-wasm/pkg",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
